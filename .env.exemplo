# =====================================================================
# Productivity Assistant - Arquivo de Configuração de Exemplo (.env)
# =====================================================================
# Instruções:
# 1. Renomeie ou copie este arquivo para '.env' na mesma pasta do executável.
# 2. Preencha as credenciais do seu banco de dados PostgreSQL e seu Git local.
# =====================================================================

# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=productivity_assistant

# Configurações do Repositório Git Local
# Exemplo Windows: D:\Projetos\PJE ou C:\Users\SeuUsuario\Projetos\PJE
DEFAULT_GIT_REPO_PATH=C:\Projetos\PJE
DEFAULT_REPO_NAME=PJE
GIT_AUTHOR_NAME=seu.nome.usuario
GIT_AUTHOR_EMAIL=seu.email@tjce.jus.br

# Configurações do Redmine Corporativo
REDMINE_URL=https://redmine.tjce.jus.br
REDMINE_API_KEY=sua_api_key_do_redmine
REDMINE_PROJECT_ID=52
REDMINE_TRACKER_ID=156

# Configurações do Servidor Local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=False
