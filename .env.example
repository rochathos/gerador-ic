# ==============================================================================
# Productivity Assistant - Exemplo de Configuração de Ambiente
# ==============================================================================

APP_NAME="Productivity Assistant"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL Local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345
DB_NAME=productivity_assistant
DATABASE_URL=postgresql+psycopg2://postgres:12345@localhost:5432/productivity_assistant

# Git Local
DEFAULT_GIT_REPO_PATH=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Redmine Corporativo (Fases Futuras)
REDMINE_URL=https://redmine.corporativo.local
REDMINE_USERNAME=
REDMINE_PASSWORD=

# Chrome & Selenium (Fases Futuras)
CHROME_PROFILE_PATH=
CHROME_HEADLESS=false

# Diretórios
SCREENSHOTS_DIR=screenshots
REPORTS_DIR=reports
LOGS_DIR=logs
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
