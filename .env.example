# ==============================================================================
# Productivity Assistant - Exemplo de Configuração de Ambiente
# ==============================================================================

APP_NAME="Productivity Assistant"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL Local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345
DB_NAME=productivity_assistant
DATABASE_URL=postgresql+psycopg2://postgres:12345@localhost:5432/productivity_assistant

# Git Local
# Caminho para o repositório local do PJE clonado na sua máquina (ex: C:/ambiente/Git/PJE ou D:/Git/PJE)
DEFAULT_GIT_REPO_PATH=C:/ambiente/Git/PJE
DEFAULT_REPO_NAME=PJE

# Seu usuário/autor de commits no Git (ex: seu.nome ou nome configurado no git config user.name)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Redmine TJCE (Integração REST API)
REDMINE_URL=https://redmine.tjce.jus.br
# Obtenha sua chave pessoal em: https://redmine.tjce.jus.br/my/account (menu lateral: "Chave de acesso à API" -> "Mostrar")
REDMINE_API_KEY=
REDMINE_PROJECT_ID=52
REDMINE_TRACKER_ID=156

# Diretórios
SCREENSHOTS_DIR=screenshots
REPORTS_DIR=reports
LOGS_DIR=logs
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
